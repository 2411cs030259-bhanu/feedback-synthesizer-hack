{
  "name": "user-feedback-synthesizer-backend",
  "version": "1.0.0",
  "description": "Python FastAPI backend for User Feedback Synthesizer",
  "scripts": {
    "start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "dev": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "setup": "python -m venv .venv && .venv/Scripts/pip install -r requirements.txt"
  },
  "engines": {
    "python": ">=3.11"
  }
}
